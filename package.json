{
  "name": "opencode-rankreactor",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode V2 plugin that registers RankReactor MCP with an API-key Bearer header and oauth: false.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "RankReactor",
  "homepage": "https://github.com/rankreactorai/opencode-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rankreactorai/opencode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/rankreactorai/opencode-plugin/issues"
  },
  "keywords": [
    "opencode-plugin",
    "rankreactor",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "check:endpoints": "node scripts/check-endpoint-boundary.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "ci": "npm run typecheck && npm run test && npm run build && npm run check:endpoints && npm run check:secrets && npm run check:pack",
    "prepublishOnly": "node scripts/forbid-publish.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
